# 1. 환경 변수 및 비밀 정보 (가장 중요!)
.env
*.env
.venv/
env/
venv/
ENV/

# 2. Python 컴파일 및 캐시 파일
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 3. 데이터베이스 및 로그
*.db
*.sqlite3
/postgres_data/  # docker-compose에서 생성되는 로컬 데이터 폴더
*.log

# 4. OS 관련 파일
.DS_Store
Thumbs.db

# 5. IDE 설정 (개인 설정이므로 공유하지 않는 것이 관례)
.vscode/
.idea/

# 6. 마이그레이션 도구
# Alembic의 버전 파일들은 공유해야 하지만, 
# 로컬 테스트용 DB 설정이 담긴 파일은 제외할 수 있습니다.