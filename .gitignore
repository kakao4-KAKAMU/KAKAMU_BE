# 1. 환경 변수 및 보안 (SECRET)
# 모든 .env 파일과 임시로 만드신 .env_123 등을 차단합니다.
.env
.env.*
*.env
!.env.example  # (권장) 설정 가이드용 파일은 예외로 허용
firebase-adminsdk.json

# 2. Python 관련 캐시 및 환경
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# 3. 데이터베이스 및 Docker 데이터
# 로컬 테스트용 DB 파일과 도커가 생성한 데이터 폴더를 제외합니다.
*.db
*.sqlite3
/postgres_data/
/pgadmin_data/
/redis_data/

# 4. Alembic 관련
# 마이그레이션 실행 시 생성되는 캐시를 제외합니다.
alembic/__pycache__/
# (주의) alembic/versions/*.py 파일들은 절대 제외하면 안 됩니다! 
# 이 파일들은 팀원과 공유해야 하는 DB 설계도입니다.

# 5. IDE 및 OS 설정
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# 6. 로그 및 임시 파일
*.log
*.tmp
*.bak